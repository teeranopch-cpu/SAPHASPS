{
  "entities": {
    "ConnectionProbe": {
      "title": "ConnectionProbe",
      "description": "Read-only connectivity probe document.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      }
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Verified administrator account authorized for elevated operations.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified email address of the administrator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of record creation."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "VaultIndex": {
      "title": "VaultIndex",
      "description": "Master index and integration settings document for an application vault.",
      "type": "object",
      "properties": {
        "examIds": {
          "type": "array",
          "description": "Ordered list of active exam IDs (bounded up to 500)."
        },
        "submissionIds": {
          "type": "array",
          "description": "Ordered list of submission IDs (bounded up to 5000)."
        },
        "spreadsheetId": {
          "type": "string",
          "maxLength": 200,
          "description": "Connected Google Sheets spreadsheet ID."
        },
        "spreadsheetUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Connected Google Sheets URL."
        },
        "spreadsheetTitle": {
          "type": "string",
          "maxLength": 300,
          "description": "Connected Google Sheets title."
        },
        "sheetTabName": {
          "type": "string",
          "maxLength": 200,
          "description": "Target tab name in Google Sheets."
        },
        "appsScriptWebhookUrl": {
          "type": "string",
          "maxLength": 600,
          "description": "Optional Google Apps Script webhook URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "examIds",
        "submissionIds",
        "spreadsheetId",
        "spreadsheetUrl",
        "spreadsheetTitle",
        "sheetTabName",
        "appsScriptWebhookUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "MemberDocument": {
      "title": "MemberDocument",
      "description": "Registered exam member keyed by unique 6-digit PIN (excluding reserved admin PIN 000000).",
      "type": "object",
      "properties": {
        "pin": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^\\d{6}$",
          "description": "Unique 6-digit PIN chosen by the member."
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Thai name prefix (คำนำหน้าชื่อ)."
        },
        "nameBody": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Normalized first and last name without prefix."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Full display name combining prefix and nameBody."
        },
        "memberRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Position or status such as ครู, นักเรียน, บุคลากรทางการศึกษา."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "pin",
        "prefix",
        "nameBody",
        "displayName",
        "memberRole",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExamDocument": {
      "title": "ExamDocument",
      "description": "Online exam definition with schedule, certificate layout config, and answer-keyed questions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "passingPercent": {
          "type": "number"
        },
        "publishDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "certificatePublishDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "templateId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "certificateConfig": {
          "type": "object"
        },
        "questions": {
          "type": "array"
        },
        "createdAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "passingPercent",
        "publishDate",
        "certificatePublishDate",
        "templateId",
        "certificateConfig",
        "questions",
        "createdAtIso",
        "createdAt",
        "updatedAt"
      ]
    },
    "CertificateTemplate": {
      "title": "CertificateTemplate",
      "description": "Chunked base64 certificate template image stored safely below Firestore 1MB limit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "part0": {
          "type": "string",
          "minLength": 20,
          "maxLength": 320000
        },
        "part1": {
          "type": "string",
          "maxLength": 320000
        },
        "part2": {
          "type": "string",
          "maxLength": 320000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "part0", "part1", "part2", "createdAt", "updatedAt"]
    },
    "SubmissionDocument": {
      "title": "SubmissionDocument",
      "description": "Graded member exam submission record with terminal outcome locking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "certificatePublishDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "templateId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "certificateConfig": {
          "type": "object"
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "nameBody": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "memberRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "memberPin": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^\\d{6}$"
        },
        "score": {
          "type": "number"
        },
        "totalQuestions": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        },
        "statusText": {
          "type": "string",
          "enum": ["ผ่าน", "ไม่ผ่าน"],
          "maxLength": 20
        },
        "certificateNo": {
          "type": "string",
          "maxLength": 64
        },
        "submittedAt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "sheetSynced": {
          "type": "boolean"
        },
        "webhookSynced": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "examId",
        "examTitle",
        "certificatePublishDate",
        "templateId",
        "certificateConfig",
        "prefix",
        "nameBody",
        "studentName",
        "memberRole",
        "memberPin",
        "score",
        "totalQuestions",
        "percentage",
        "passed",
        "statusText",
        "certificateNo",
        "submittedAt",
        "sheetSynced",
        "webhookSynced",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionProbe" },
      "description": "Read-only connection verification endpoint."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Administrator registry keyed by Firebase Auth UID."
    },
    "/vaults/{vaultId}": {
      "schema": { "$ref": "#/entities/VaultIndex" },
      "description": "Master index and integration settings keyed by high-entropy capability ID."
    },
    "/vaults/{vaultId}/members/{memberPin}": {
      "schema": { "$ref": "#/entities/MemberDocument" },
      "description": "Registered members keyed by unique 6-digit PIN."
    },
    "/vaults/{vaultId}/exams/{examId}": {
      "schema": { "$ref": "#/entities/ExamDocument" },
      "description": "Exam sets belonging to the parent vault."
    },
    "/vaults/{vaultId}/templates/{templateId}": {
      "schema": { "$ref": "#/entities/CertificateTemplate" },
      "description": "Chunked certificate template images belonging to the parent vault."
    },
    "/vaults/{vaultId}/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/SubmissionDocument" },
      "description": "Member exam submissions belonging to the parent vault."
    }
  }
}
